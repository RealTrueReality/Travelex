@using Travelex.Services
@inject QwenService QwenService

<details class="mx-4 mb-2 rounded-xl border border-outline bg-surface px-4 py-3 text-sm">
    <summary class="cursor-pointer font-semibold text-content">
        AI 设置：@_selectedModel · Key @(_hasApiKey ? "已保存" : "未设置")
    </summary>
    <div class="mt-3 space-y-3">
        <label class="block font-medium text-content" for="ai-model">分析模型</label>
        <select id="ai-model" class="form-control h-11" @bind="_selectedModel" @bind:after="SaveModel">
            <option value="@Travelex.Services.QwenService.QwenModel">千问 Qwen3.8 Max</option>
            <option value="@Travelex.Services.QwenService.DeepSeekModel">DeepSeek V4 Pro 0813</option>
        </select>
        <p class="text-content-muted">两个模型都通过千问 AI 平台调用。免费额度以账号权益页为准；用尽后可能产生费用，建议在平台开启“免费额度用尽即停”。模型切换只影响之后发起的请求。</p>
        <p class="text-content-muted">个人使用时可在本机保存自己的 Key；不会写入安装包或 Git。公开分发时请改用后端代理，手机端保存的 Key 仍可能被设备持有者提取。</p>
        <label class="block font-medium text-content" for="qwen-api-key">API Key</label>
        <input id="qwen-api-key" type="password" autocomplete="off" spellcheck="false"
               @bind="_apiKeyInput" class="form-control h-11" placeholder="粘贴 sk-ws- 开头的 Key" />
        <div class="flex gap-2">
            <button type="button" class="btn-primary w-auto px-5" @onclick="SaveKeyAsync" disabled="@_saving">保存到本机</button>
            @if (_hasApiKey) {
                <button type="button" class="btn-secondary w-auto px-5" @onclick="RemoveKey">移除 Key</button>
            }
        </div>
        @if (!string.IsNullOrEmpty(_status)) {
            <p role="status" class="text-content-muted">@_status</p>
        }
    </div>
</details>

@code {
    private string _apiKeyInput = string.Empty;
    private string _selectedModel = Travelex.Services.QwenService.QwenModel;
    private string _status = string.Empty;
    private bool _hasApiKey;
    private bool _saving;

    protected override async Task OnInitializedAsync() {
        try {
            _selectedModel = QwenService.GetSelectedModel();
            _hasApiKey = await QwenService.HasApiKeyAsync();
        }
        catch (Exception) {
            _status = "无法读取本机设置，请检查设备存储。";
        }
    }

    private void SaveModel() {
        try {
            QwenService.SetSelectedModel(_selectedModel);
            _status = $"已切换到 {_selectedModel}，下一次分析生效。";
        }
        catch (ArgumentException ex) {
            _selectedModel = QwenService.GetSelectedModel();
            _status = ex.Message;
        }
        catch (Exception) {
            _status = "模型选择保存失败，请检查设备存储。";
        }
    }

    private async Task SaveKeyAsync() {
        if (string.IsNullOrWhiteSpace(_apiKeyInput)) {
            _status = "请先输入 API Key。";
            return;
        }

        _saving = true;
        try {
            await QwenService.SaveApiKeyAsync(_apiKeyInput);
            _hasApiKey = true;
            _apiKeyInput = string.Empty;
            _status = "已保存。现在可以使用 AI 分析。";
        }
        catch (ArgumentException ex) {
            _status = ex.Message;
        }
        catch (Exception) {
            _status = "保存失败，请检查设备安全存储是否可用。";
        }
        finally {
            _saving = false;
        }
    }

    private void RemoveKey() {
        QwenService.RemoveApiKey();
        _hasApiKey = false;
        _apiKeyInput = string.Empty;
        _status = "本机 Key 已移除。";
    }
}
