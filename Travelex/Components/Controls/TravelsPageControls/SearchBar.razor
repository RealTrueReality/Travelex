@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="app-topbar bg-canvas">
    @if (!IsSearching)
    {
        <div class="flex-1">
            <button type="button" @onclick="NavigateToAdd" class="icon-button" aria-label="添加行程">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
            </button>
        </div>
        <h1 class="text-text-light dark:text-text-dark text-lg font-bold">我的旅行</h1>
        <div class="flex-1 flex justify-end">
            <button type="button" @onclick="ToggleSearch" class="icon-button" aria-label="搜索行程">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-text-light dark:text-text-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </button>
        </div>
    }
    else
    {
        <div class="w-full flex items-center gap-2 animate-fade-in">
            <input type="text"
                   value="@SearchQuery"
                   @oninput="OnSearchInput"
                   @onkeyup="HandleKeyUp"
                   inputmode="search"
                   aria-label="搜索行程"
                   class="form-control min-w-0 flex-1 h-11"
                   placeholder="搜索旅行..."
                   @ref="_searchInput"/>
            <button type="button" @onclick="ToggleSearch" class="icon-button" aria-label="关闭搜索">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    }
</div>

@code {
    private bool IsSearching { get; set; }
    private bool _focusSearchAfterRender;
    private ElementReference _searchInput;
    
    [Parameter] public string SearchQuery { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchQueryChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearchAfterRender)
        {
            _focusSearchAfterRender = false;
            await _searchInput.FocusAsync();
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? string.Empty;
        await SearchQueryChanged.InvokeAsync(SearchQuery);
    }

    private async Task ToggleSearch()
    {
        IsSearching = !IsSearching;
        if (!IsSearching)
        {
            SearchQuery = string.Empty;
            await SearchQueryChanged.InvokeAsync(SearchQuery);
        }
        else
        {
            _focusSearchAfterRender = true;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await JSRuntime.InvokeVoidAsync("blurActiveElement");
        }
    }

    private void NavigateToAdd()
    {
        NavigationManager.NavigateTo("/travel/add");
    }
}
